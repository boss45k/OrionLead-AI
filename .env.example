# ============================================================
# OrionLead AI — Environment Configuration
# ============================================================
# INSTRUCTIONS:
#   1. Copy this file to .env  →  cp .env.example .env
#   2. Fill in all required values (marked REQUIRED)
#   3. Never commit .env to version control
#   4. Rotate any key you believe was exposed (see ROTATING KEYS below)
#
# ROTATING EXPOSED KEYS:
#   MySQL     : ALTER USER 'root'@'localhost' IDENTIFIED BY 'new-password';
#   JWT/Flask : Generate new random: python -c "import secrets; print(secrets.token_hex(32))"
#   Gemini    : https://aistudio.google.com/app/apikey  → Revoke + create new
#   Groq      : https://console.groq.com/keys           → Delete + create new
#   OpenAI    : https://platform.openai.com/api-keys    → Revoke + create new
#   Supabase  : Dashboard → Settings → API → Regenerate anon/service keys
# ============================================================

# ── Server ───────────────────────────────────────────────────────────────────
# FLASK_ENV controls the config class used (development | production | testing)
# production: debug off, secrets validated, WSGI entrypoint (wsgi.py)
# development: debug on, debug routes active, run.py entrypoint
FLASK_ENV=production
API_PORT=5000
API_HOST=0.0.0.0

# ── Security secrets (REQUIRED in production) ────────────────────────────────
# Generate strong values:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-64-hex-char-random-string
JWT_SECRET_KEY=replace-with-another-64-hex-char-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ── Database — MySQL (REQUIRED) ──────────────────────────────────────────────
# Format: mysql+pymysql://user:password@host:port/database
DATABASE_URL=mysql+pymysql://root:your-secure-password@localhost:3306/ai_lead_db
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-secure-password
MYSQL_DATABASE=ai_lead_db

# ── Supabase (REQUIRED — used for MySQL ↔ mobile sync) ───────────────────────
# Find at: https://supabase.com/dashboard/project/<id>/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
# Anon key: safe to expose to clients (row-level security enforces access)
SUPABASE_ANON_KEY=your-supabase-anon-key
# Service key: NEVER expose to clients — backend only, has full DB access
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
# Webhook secret: used to verify HMAC signatures on incoming Supabase webhooks
SUPABASE_WEBHOOK_SECRET=replace-with-random-hex-string

# ── AI / LLM providers ───────────────────────────────────────────────────────
# Primary: Gemini 2.5 Flash (fast, generous free tier)
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# Fallback: Groq (ultra-fast inference, used when Gemini fails)
# https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key

# Legacy/QueryAgent path: OpenAI (optional — only used by QueryAgent via LLMIntegration)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key

# ── Frontend URLs ─────────────────────────────────────────────────────────────
REACT_APP_API_URL=http://localhost:5000
REACT_APP_WS_URL=ws://localhost:5000

# CORS: comma-separated allowed origins
# Add your LAN IP if testing with a physical device
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8081

# ── AI/ML configuration ───────────────────────────────────────────────────────
MODEL_PATH=./models/
MAX_WORKERS=4
BATCH_SIZE=32
CONFIDENCE_THRESHOLD=0.5

# ── Data collection ───────────────────────────────────────────────────────────
CRAWL_RATE_LIMIT=10
CRAWL_TIMEOUT=30
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64)

# ── Firebase Cloud Messaging — push notifications (optional) ────────────────
# Service account JSON file downloaded from Firebase Console → Project Settings → Service Accounts
# NEVER commit the actual .json file — add its path here and gitignore the file
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# ── Hugging Face (optional — used by semantic intent detection) ───────────────
# Free token at: https://huggingface.co/settings/tokens
HF_TOKEN=your-huggingface-token

# ── Hunter.io (legacy alias — prefer HUNTER_API_KEY above) ───────────────────
HUNTER_IO_API_KEY=your-hunter-io-api-key

# ── Email / SMTP (optional) ──────────────────────────────────────────────────
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password

# ── Social media APIs (optional) ─────────────────────────────────────────────
LINKEDIN_API_KEY=your-linkedin-api-key
FACEBOOK_API_KEY=your-facebook-api-key
FACEBOOK_API_SECRET=your-facebook-api-secret

# ── Lead enrichment APIs (optional) ─────────────────────────────────────────
CLEARBIT_API_KEY=your-clearbit-api-key
HUNTER_API_KEY=your-hunter-api-key
PDL_API_KEY=your-pdl-api-key
APOLLO_API_KEY=your-apollo-api-key
# Snov.io — email finder by name+domain. Value can be "client_id:client_secret" or a bare access token.
SNOV_API_KEY=your-snov-client-id:your-snov-client-secret
# Lusha — verified email + direct-dial phone by name+company
LUSHA_API_KEY=your-lusha-api-key
# RocketReach — email/phone/LinkedIn/position lookup by name, LinkedIn URL, or email
ROCKETREACH_API_KEY=your-rocketreach-api-key

# ── Extended collection sources (optional) ───────────────────────────────────
# GitHub — free with auth (5 000 req/hr); unauthenticated is 60/hr.
# Create at: https://github.com/settings/tokens  (no scope needed for public data)
GITHUB_TOKEN=your-github-personal-access-token

# Crunchbase Basic API — 200 calls/day free tier
# Register at: https://data.crunchbase.com/docs/using-the-api
CRUNCHBASE_API_KEY=your-crunchbase-api-key

# Email verification — prevents bad emails from counting as verified
# ZeroBounce: 100 free verifications/month → https://www.zerobounce.net
ZEROBOUNCE_API_KEY=your-zerobounce-api-key
# Abstract API alternative: 100 free/month → https://www.abstractapi.com/email-verification-api
ABSTRACT_EMAIL_API_KEY=your-abstract-api-key

# Explorium — B2B data enrichment + verified contact discovery + buyer signals
# Admin: https://admin.explorium.ai  Docs: https://developers.explorium.ai
# Reliability: 85 (verified work emails + firmographics)
EXPLORIUM_API_KEY=your-explorium-api-key

# ── Infrastructure ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
CACHE_REDIS_URL=redis://localhost:6379/0

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# ── AWS (optional) ────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ── Sync tuning (optional) ────────────────────────────────────────────────────
SYNC_BATCH_SIZE=50
SYNC_MAX_RETRIES=3
SYNC_RETRY_DELAY_S=1.0

# ── AI timeout tuning (optional) ──────────────────────────────────────────────
# Gemini 2.5 Flash is a thinking model — complex prompts can take 30-60s.
# Increase GEMINI_TIMEOUT if you see frequent timeouts on lead collection.
GEMINI_TIMEOUT=60
GROQ_TIMEOUT=15
