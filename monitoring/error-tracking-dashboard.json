{
  "dashboard": {
    "title": "Error Tracking & System Health",
    "description": "Error rates, exception types, and system health indicators",
    "tags": ["errors", "exceptions", "health"],
    "timezone": "browser",
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "title": "Error Rate (5m)",
        "type": "stat",
        "targets": [
          {
            "expr": "rate(errors_total[5m])"
          }
        ],
        "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0},
        "fieldConfig": {
          "defaults": {"unit": "ops"}
        }
      },
      {
        "id": 2,
        "title": "Exception Rate (5m)",
        "type": "stat",
        "targets": [
          {
            "expr": "rate(exceptions_total[5m])"
          }
        ],
        "gridPos": {"h": 8, "w": 6, "x": 6, "y": 0},
        "fieldConfig": {
          "defaults": {"unit": "ops"}
        }
      },
      {
        "id": 3,
        "title": "System Uptime",
        "type": "stat",
        "targets": [
          {
            "expr": "system_uptime_seconds / 86400"
          }
        ],
        "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0},
        "fieldConfig": {
          "defaults": {"unit": "d"}
        }
      },
      {
        "id": 4,
        "title": "Total Errors (24h)",
        "type": "stat",
        "targets": [
          {
            "expr": "increase(errors_total[24h])"
          }
        ],
        "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0}
      },
      {
        "id": 5,
        "title": "Error Types Distribution (1h)",
        "type": "piechart",
        "targets": [
          {
            "expr": "sum(increase(errors_total[1h])) by (error_type)"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
      },
      {
        "id": 6,
        "title": "Exception Types Distribution (1h)",
        "type": "piechart",
        "targets": [
          {
            "expr": "sum(increase(exceptions_total[1h])) by (exception_type)"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
      },
      {
        "id": 7,
        "title": "Error Rate Trend (24h)",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(errors_total[5m])",
            "legendFormat": "{{error_type}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
        "yaxes": [
          {"format": "ops", "label": "Errors/sec"}
        ]
      },
      {
        "id": 8,
        "title": "Exception Rate Trend (24h)",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(exceptions_total[5m])",
            "legendFormat": "{{exception_type}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
        "yaxes": [
          {"format": "ops", "label": "Exceptions/sec"}
        ]
      },
      {
        "id": 9,
        "title": "Top 5 Error Types (5m)",
        "type": "table",
        "targets": [
          {
            "expr": "topk(5, rate(errors_total[5m]))"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24}
      },
      {
        "id": 10,
        "title": "Top 5 Exception Types (5m)",
        "type": "table",
        "targets": [
          {
            "expr": "topk(5, rate(exceptions_total[5m]))"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24}
      },
      {
        "id": 11,
        "title": "HTTP 5xx Error Rate",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(http_requests_total{status_code=~'5..'}[5m])",
            "legendFormat": "{{status_code}} {{endpoint}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 32},
        "yaxes": [
          {"format": "ops", "label": "5xx Errors/sec"}
        ]
      },
      {
        "id": 12,
        "title": "HTTP 4xx Error Rate",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(http_requests_total{status_code=~'4..'}[5m])",
            "legendFormat": "{{status_code}} {{endpoint}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 32},
        "yaxes": [
          {"format": "ops", "label": "4xx Errors/sec"}
        ]
      }
    ]
  },
  "overwrite": false
}
