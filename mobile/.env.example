# Mobile app environment variables
# Copy this file to .env (never commit .env) and fill in your values.
# These are read by app.config.js at Expo build/start time.

# Supabase project credentials
# Find these at: https://supabase.com/dashboard/project/<your-project>/settings/api
# Only the anon (publishable) key should be used here — never the service_role key.
EXPO_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_SUPABASE_ANON_KEY=your-supabase-anon-key

# Flask backend URL (your LAN IP for device testing, or production URL)
EXPO_API_BASE_URL=http://localhost:5000
