          <mxGeometry height="840" width="1540" x="50" y="150" as="geometry" />
        </mxCell>
        <mxCell id="5" parent="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;fontColor=#B71C1C;align=center;verticalAlign=top;arcSize=8;" value="&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 22px;&quot;&gt;M2 — Anti-Junk Domain Filter&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size: 22px;&quot;&gt;Screens company domain before any API calls&lt;br&gt;Rejects: free email domains, placeholder companies&lt;br&gt;Rejects: known test/spam domains, no-website companies&lt;br&gt;Output: domain_valid = true / false&lt;/font&gt;" vertex="1">
          <mxGeometry height="235" width="440" x="20" y="50" as="geometry" />
        </mxCell>
        <mxCell id="6" parent="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;fontColor=#BF360C;align=center;verticalAlign=top;arcSize=8;" value="&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 22px;&quot;&gt;M3 — Website Auditor&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size: 22px;&quot;&gt;Fetches company homepage via Serper.dev or Google Places&lt;br&gt;Extracts: title, meta description, tech stack signals&lt;br&gt;Scores: professionalism, website age, HTTPS, content depth&lt;br&gt;Output: website_score (0–100) + tech_signals&lt;/font&gt;" vertex="1">
          <mxGeometry height="235" width="480" x="530" y="50" as="geometry" />
        </mxCell>
        <mxCell id="7" parent="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F9A825;fontColor=#E65C00;align=center;verticalAlign=top;arcSize=8;" value="&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;M4 — Business Classifier&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Classifies company into ICP (Ideal Customer Profile) buckets&lt;br&gt;Categories: SaaS, E-commerce, Agency, Enterprise, SMB, Startup&lt;br&gt;Uses Gemini to interpret website content + signals&lt;br&gt;Output: industry, company_type, icp_match_score&lt;/font&gt;" vertex="1">
          <mxGeometry height="235" width="440" x="1080" y="50" as="geometry" />
        </mxCell>
        <mxCell id="8" parent="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B71C1C;strokeColor=#7F0000;fontColor=#FFFFFF;align=center;verticalAlign=middle;arcSize=20;fontStyle=1;fontSize=12;" value="&lt;font style=&quot;font-size: 22px;&quot;&gt;Company REJECTED (score &amp;lt; 65 or domain invalid)&lt;/font&gt;" vertex="1">
          <mxGeometry height="170" width="190" y="400" as="geometry" />
        </mxCell>
        <mxCell id="bzOS7Ap13feLCkzynXlh-19" edge="1" parent="4" source="9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="10" value="">
          <mxGeometry relative="1" as="geometry" />
