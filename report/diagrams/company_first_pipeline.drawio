        <mxCell id="bzOS7Ap13feLCkzynXlh-26" edge="1" parent="4" source="9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="8" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="9" parent="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontColor=#1B5E20;align=center;verticalAlign=top;arcSize=8;" value="&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 21px;&quot;&gt;M5 — Growth Detector &amp;amp; Account Scorer&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size: 21px;&quot;&gt;Growth signals: recent funding, job postings, product launches&lt;br&gt;Hiring trend analysis via Serper.dev news search&lt;br&gt;Account score = website_score × 0.3 + icp_match × 0.4 + growth × 0.3&lt;br&gt;Threshold: account_score ≥ 65 → proceed to contact resolution&lt;br&gt;Output: account_score + growth_signals[] + proceed flag&lt;/font&gt;" vertex="1">
          <mxGeometry height="255" width="580" x="260" y="345" as="geometry" />
        </mxCell>
        <mxCell id="bzOS7Ap13feLCkzynXlh-20" edge="1" parent="4" source="10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="9" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="10" parent="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#6A1B9A;fontColor=#4A148C;align=center;verticalAlign=top;arcSize=8;" value="&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 22px;&quot;&gt;M6 — Contact Resolver&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size: 22px;&quot;&gt;Only runs AFTER company passes M5 threshold gate&lt;br&gt;Queries: Hunter.io (email), Apollo.io (profile), People Data Labs&lt;br&gt;Resolves: decision-maker name · verified email · title · LinkedIn&lt;br&gt;Validates email via ZeroBounce before saving&lt;br&gt;Output: verified contact record → AI Cascade (Fig 4.2)&lt;/font&gt;" vertex="1">
          <mxGeometry height="255" width="600" x="910" y="345" as="geometry" />
        </mxCell>
