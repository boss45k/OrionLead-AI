        "id": "CRIT-004",
        "title": "Agent Pool Not Eagerly Initialized",
        "severity": "🔴 CRITICAL",
        "file": "backend/app/agents/agent_pool.py:157",
        "pattern": "Lazy Singleton (on-demand)",
        "issue": "Pool created on first request, not thread-safe during initialization",
        "impact": "Race conditions under concurrent load, multiple pools created",
        "concurrency_issue": "YES",
        "fix_complexity": "MEDIUM",
        "fix_time_minutes": 30,
        "solution": "Initialize pool eagerly in app/__init__.py on startup",
        "priority": "CRITICAL"
      },
      {
        "id": "CRIT-005",
        "title": "Advanced AI Stack Global State Not Thread-Safe",
        "severity": "🔴 CRITICAL",
        "file": "backend/app/services/advanced_ai.py",
        "global_state": [
          "_ollama_client = None",
          "_spacy_nlp = None",
          "_ml_model = None",
          "_faiss_dedup = None",
          "_embedder = None"
        ],
        "issue": "Global variables without synchronization for multi-threaded access",
        "impact": "Concurrent requests may reinitialize components, memory leaks, unpredictable behavior",
        "threading_issue": "YES",
        "fix_complexity": "MEDIUM",
        "fix_time_minutes": 90,
        "solution": "Use thread-local storage, context managers, or request-scoped initialization",
        "priority": "CRITICAL"
      }
    ],
